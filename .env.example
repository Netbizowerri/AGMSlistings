# Copy to .env.local and fill in with the values from
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup
#
# These Firebase Web SDK values are client-side and therefore not secrets.
# Authorization is enforced by Firebase Auth + Firestore security rules
# (see firestore.rules), never by hiding these values.
#
# Do NOT commit .env.local (it is gitignored). Add these to the Vercel project
# under Settings -> Environment Variables for production.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public canonical origin used for <link rel="canonical">, Open Graph og:url and
# the build-time sitemap. No trailing slash.
VITE_SITE_URL=https://www.agms.com.ng